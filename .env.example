# Keep all keys on the Python server. Never paste them into the browser.
OPENAI_API_KEY=
# Optional: read an existing key file instead of copying its value.
OPENAI_API_KEY_FILE=
NALAM_ACCESS_CODE=
NALAM_CAREGIVER_PIN=
NALAM_DATA_DIR=./data
NALAM_SECURE_COOKIES=false
NALAM_PUBLIC_ORIGIN=http://127.0.0.1:8787
NALAM_TIMEZONE=UTC
NALAM_TEXT_MODEL=gpt-4.1-mini
NALAM_TTS_MODEL=gpt-4o-mini-tts
NALAM_STT_MODEL=gpt-4o-mini-transcribe
NALAM_VOICE=coral
# Labelled synthetic walkthrough; prewritten samples are not live AI analysis.
NALAM_REVIEW_MODE=false
NALAM_DAILY_CHAT_LIMIT=30
NALAM_DAILY_REPORT_LIMIT=8
NALAM_DAILY_SPEECH_LIMIT=80
NALAM_DAILY_TRANSCRIBE_LIMIT=30
# A contact URL/mailto URI used only in the push protocol, never sent to users.
NALAM_PUSH_CONTACT=https://example.com/nalam
